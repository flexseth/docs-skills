{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "note-box/note",
	"version": "0.1.0",
	"title": "Note Box",
	"category": "text",
	"icon": "edit-page",
	"description": "Displays a short note in a paragraph.",
	"attributes": {
		"note": {
			"type": "string",
			"source": "text",
			"selector": "p",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "note-box",
	"editorScript": "file:./index.js"
}
