{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "team-directory/list",
	"version": "1.0.0",
	"title": "Team Directory",
	"category": "widgets",
	"icon": "groups",
	"description": "Lists team members, optionally filtered by role.",
	"keywords": [ "team", "members", "staff", "directory" ],
	"textdomain": "team-directory",
	"attributes": {
		"role": {
			"type": "string",
			"default": ""
		},
		"perPage": {
			"type": "integer",
			"default": 10
		},
		"showStartYear": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"color": {
			"background": true,
			"text": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
